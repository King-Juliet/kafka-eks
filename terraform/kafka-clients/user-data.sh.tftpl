#!/bin/bash
# Installs the Kafka CLI tools and writes /etc/kafka-client/client.properties for user ${kafka_user}.
# Your real producer/consumer application replaces the "smoke test" part - this only prepares the box.
set -euo pipefail
exec > >(tee /var/log/kafka-client-bootstrap.log) 2>&1

dnf install -y java-21-amazon-corretto-headless jq tar gzip

mkdir -p /opt/kafka /etc/kafka-client
curl -fsSL "${kafka_download_url}" -o /tmp/kafka.tgz
tar -xzf /tmp/kafka.tgz -C /opt/kafka --strip-components=1

# Secrets are pushed by External Secrets (PushSecret) once Kafka is up. Retry for ~10 minutes.
get_secret() {
  for i in $(seq 1 30); do
    if aws secretsmanager get-secret-value --region "${region}" --secret-id "$1" --query SecretString --output text 2>/dev/null; then
      return 0
    fi
    sleep 20
  done
  echo "secret $1 not available" >&2
  return 1
}

PASSWORD="$(get_secret "${password_secret_id}")"
get_secret "${ca_secret_id}" > /etc/kafka-client/ca.crt

keytool -importcert -noprompt -alias strimzi-cluster-ca \
  -file /etc/kafka-client/ca.crt \
  -keystore /etc/kafka-client/truststore.p12 -storetype PKCS12 -storepass changeit

cat > /etc/kafka-client/client.properties <<PROPS
security.protocol=SASL_SSL
sasl.mechanism=SCRAM-SHA-512
sasl.jaas.config=org.apache.kafka.common.security.scram.ScramLoginModule required username="${kafka_user}" password="$PASSWORD";
ssl.truststore.location=/etc/kafka-client/truststore.p12
ssl.truststore.password=changeit
ssl.truststore.type=PKCS12
PROPS
chmod 600 /etc/kafka-client/client.properties

echo 'export KAFKA_HOME=/opt/kafka' > /etc/profile.d/kafka.sh
echo 'export PATH=$PATH:/opt/kafka/bin' >> /etc/profile.d/kafka.sh
echo 'export BOOTSTRAP="${bootstrap_servers}"' >> /etc/profile.d/kafka.sh
echo "bootstrap complete"